# Required — app will not start without these
DATABASE_URL=postgresql://sreai:password@localhost:5432/sreai
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=sk-...
JWT_SECRET=<min 32 chars, random>
JWT_REFRESH_SECRET=<min 32 chars, different from JWT_SECRET>
ENCRYPTION_KEY=<32 bytes, hex — for encrypting integration credentials>

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
SQS_P1_QUEUE_URL=...
SQS_P2_QUEUE_URL=...
SQS_DLQ_URL=...
SQS_ACTIONS_QUEUE_URL=...
SQS_ACTIONS_DLQ_URL=...
# Create queues + redrive policies on start-up. Defaults to true only when
# LOCALSTACK_ENDPOINT is set; production queues come from infrastructure.
# SQS_AUTO_CREATE_QUEUES=false
S3_BUCKET_NAME=sreai-postmortems
# Optional S3-compatible endpoint (LocalStack/MinIO); unset for AWS
# S3_ENDPOINT=http://localhost:4566
# Daily digest sender (SES verified identity). Unset → digest goes to Slack only.
SES_FROM_EMAIL=digest@yourdomain.com

# Integrations (optional — features disabled if not set)
# Platform Slack app: bot token (tenants may bring their own) and the
# signing secret used to verify interactive button clicks.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
PAGERDUTY_API_KEY=...
GITHUB_APP_PRIVATE_KEY=...
SENTRY_DSN=...

# Public URLs
# Path the refresh-token cookie is scoped to: /auth when the API is served at
# the root, /api/auth behind the production nginx /api/ prefix.
AUTH_COOKIE_PATH=/auth
# Where the dashboard is served (CORS origin, links in Slack/PagerDuty)
DASHBOARD_URL=http://localhost:3100
# Base URL alert sources post to (ingestion-service), shown with API keys
PUBLIC_WEBHOOK_BASE_URL=http://localhost:3001

# Workers
DIAGNOSIS_CONCURRENCY=5
# BullMQ key prefix (namespace per environment)
BULLMQ_PREFIX=sreai
# Set to false to run a service's HTTP API without its queue consumers /
# BullMQ workers (e.g. a read-only replica)
# CONSUMERS_ENABLED=true
# WORKERS_ENABLED=true

# Security
# Tenant-supplied URLs (health checks, Prometheus, Loki, Redis) may not
# resolve to private/link-local addresses unless this is true. Local dev only.
ALLOW_PRIVATE_NETWORK_TARGETS=false
# SNS signature verification for CloudWatch alarms. Never disable in production.
# SNS_VERIFY_SIGNATURES=true

# Optional overrides (proxies, GitHub Enterprise, local mocks)
# OPENAI_BASE_URL=
# GITHUB_API_URL=https://api.github.com

# Logging
LOG_LEVEL=debug
# Opt-in TypeORM query logging (console-based, so off by default)
DB_QUERY_LOGGING=false

# Local dev only
LOCALSTACK_ENDPOINT=http://localhost:4566

# Per-service ports (local dev) — distinct names since all 4 services
# load this same root .env file; a shared PORT would collide.
API_GATEWAY_PORT=3000
INGESTION_SERVICE_PORT=3001
DIAGNOSIS_SERVICE_PORT=3002
ACTION_SERVICE_PORT=3003

# Integration/e2e tests: a Postgres server URL (any db). Each test file
# creates and drops its own database on it. Unset → testcontainers.
# TEST_DATABASE_URL=postgresql://sreai:password@localhost:5432/postgres
