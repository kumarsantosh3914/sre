{
  "name": "sre-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=\"./apps/*\" run dev",
    "build": "pnpm -r --filter=\"./apps/*\" --filter=\"./packages/*\" run build",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"apps/**/*.ts\" \"packages/**/*.ts\"",
    "test": "pnpm -r --filter=\"./apps/*\" --filter=\"./packages/*\" run test",
    "test:cov": "pnpm -r --filter=\"./apps/*\" --filter=\"./packages/*\" run test:cov",
    "test:e2e": "pnpm -r --filter=\"./apps/*\" run test:e2e"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
