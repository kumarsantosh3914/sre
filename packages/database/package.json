{
  "name": "@sreai/database",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests",
    "test:cov": "jest --coverage",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "dotenv -e ../../.env -- typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "dotenv -e ../../.env -- typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@sreai/shared": "workspace:*",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "@testcontainers/postgresql": "^10.13.1"
  },
  "files": [
    "dist",
    "testing.js",
    "testing.d.ts"
  ],
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/index.ts",
      "!migrations/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testTimeout": 120000
  }
}
